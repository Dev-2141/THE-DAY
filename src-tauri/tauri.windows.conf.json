{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build && npm run python:fetch"
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "../hub/server.py": "hub/server.py",
      "../hub/hub.py": "hub/hub.py",
      "../hub/hub_core/*.py": "hub/hub_core/",
      "python/*": "python/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
