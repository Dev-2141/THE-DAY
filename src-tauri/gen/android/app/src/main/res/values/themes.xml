<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      The app's theme: the warm cream of the loading screen behind the web
      view (so nothing flashes while it starts), drawn under the display
      cut-out; MainActivity hides the system bars for an immersive view.
    -->
    <style name="Theme.the_day" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/the_day_cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
    </style>

    <!-- The splash screen (Android 12 and later, and back to Android 7 through core-splashscreen). -->
    <style name="Theme.the_day.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/the_day_cream</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.the_day</item>
    </style>
</resources>
